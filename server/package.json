{
  "name": "@ticketproject/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "exports": {
    ".": "./src/api/router.ts"
  },
  "scripts": {
    "dev": "cross-env SEGMENT_CAP=3000 tsx --env-file=../.env --watch src/server.js",
    "dev:canned": "cross-env ROUTES_SOURCE=canned SEGMENT_CAP=3000 tsx --env-file=../.env --watch src/server.js",
    "start": "node --env-file=../.env src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:full": "cross-env TREE_CACHED=1 node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/matching-gtfs-full.test.ts",
    "test:tied": "cross-env TREE_CACHED=1 node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/matching-gtfs-tied.test.ts",
    "test:interpolation": "cross-env TREE_CACHED=1 node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/matching-gtfs-interpolation.test.ts",
    "test:interpolation:viz": "cross-env TREE_CACHED=1 node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/matching-gtfs-interpolation-viz.test.ts",
    "cache:tree": "tsx src/persistence/buildTree.ts",
    "cache:tree:rebuild": "tsx src/persistence/buildTree.ts --force",
    "debug:match": "tsx src/debug/debugMatch.ts",
    "wipe": "tsx --env-file=../.env src/debug/wipe.ts",
    "demo:route": "tsx --env-file=../.env src/debug/demo-route.ts",
    "demo:danger": "tsx --env-file=../.env src/debug/demo-danger.ts",
    "seed": "tsx --env-file=../.env src/debug/seed.ts",
    "seed:stops": "tsx --env-file=../.env src/debug/seed-stops.ts",
    "seed:routes": "tsx --env-file=../.env src/debug/seed-routes.ts",
    "demo:legs": "tsx --env-file=../.env src/debug/demo-legs.ts",
    "check:stops": "tsx src/debug/check-stop-distances.ts",
    "test:queries": "tsx --env-file=../.env src/debug/test-queries.ts",
    "test:trpc": "cross-env ROUTES_SOURCE=canned tsx --env-file=../.env src/debug/test-trpc.ts"
  },
  "dependencies": {
    "@clerk/fastify": "^2.2.0",
    "@fastify/cors": "^11.2.0",
    "@ticketproject/core": "workspace:*",
    "@ticketproject/db": "workspace:*",
    "@trpc/server": "^11.4.3",
    "fastify": "^5.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ticketproject/tsconfig": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "cross-env": "^7.0.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
